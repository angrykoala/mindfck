byte length=10
byte original[10] = [
  52, 50, 68, 121, 49,
  50, 50, 50,  48, 55
]

print original
print 10b

byte i=0

while(i < length) {
    byte j = 0
    while(j<length-i-1){
        if (original[j] > original[j + 1]) {
            byte temp = original[j]
            original[j] = original[j+1]
            original[j+1]=temp
        }

        j = j+1
    }

    i = i+1
}

print original

