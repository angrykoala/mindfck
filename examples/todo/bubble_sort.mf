byte length=10
byte original[10] = [1,10,5,8,8,9,4,55,2,15]
byte i=0

while(i < length) {
    var j = 0
    while(j<length-i-1){
        if (original[j] > original[j + 1]) {
            byte temp = original[j]
            original[j] = original[j+1]
            original[j+1]=temp
        }

        j = j+1
    }

    i = i+1
}



